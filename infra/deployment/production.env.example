# ==============================================================================
# Go_Volt Production Environment Template
# NEVER commit secrets or live production credentials to version control.
# ==============================================================================

# Application & Service Environment
ENVIRONMENT=production
PORT=8080
LOG_LEVEL=INFO
SERVICE_NAME=govolts-backend-api
PUBLIC_API_URL=https://api.govolts.ng

# PostgreSQL Database (Managed Supabase / RDS with PgBouncer)
DATABASE_URL=postgres://govolts_app_user:CHANGE_ME_IN_SECRET_MANAGER@db-primary.govolts.ng:6543/govolts_production?sslmode=require&pool_size=20
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL=true

# Redis In-Memory Cache & Session Store
REDIS_URL=rediss://default:CHANGE_ME_IN_SECRET_MANAGER@redis-cache.govolts.ng:6380
REDIS_KEY_PREFIX=govolts:prod:

# Security & JWT Tokens
JWT_SECRET=GENERATE_64_CHAR_CRYPTOGRAPHIC_SECRET_HERE
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=2592000

# Payment Gateway (Paystack Production Keys)
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME_PUBLIC_KEY
PAYSTACK_WEBHOOK_SECRET=whsec_CHANGE_ME_WEBHOOK_KEY

# SMS & OTP Provider (Termii / Africa's Talking)
SMS_PROVIDER=termii
TERMII_API_KEY=termii_live_api_key_here
TERMII_SENDER_ID=GoVolts

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/secrets/firebase/govolts-prod-firebase-adminsdk.json

# Object Storage (S3 / Cloud Storage / Supabase Storage for Proof of Delivery & Avatars)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=govolts-production-media
STORAGE_REGION=eu-west-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_PUBLIC_BASE_URL=https://media.govolts.ng

# Retail Ai & Partner Integration Shared Secrets
RETAIL_AI_WEBHOOK_SIGNING_SECRET=whsec_partner_retail_ai_live_secret
