# ==============================================================================
# Go_Volt Staging Environment Template
# Configured for staging verification with sandbox payment credentials
# ==============================================================================

# Application & Service Environment
ENVIRONMENT=staging
PORT=8080
LOG_LEVEL=DEBUG
SERVICE_NAME=govolts-backend-api-staging
PUBLIC_API_URL=https://api-staging.govolts.ng

# PostgreSQL Database (Staging Database)
DATABASE_URL=postgres://govolts_staging_user:CHANGE_ME_IN_SECRET_MANAGER@db-staging.govolts.ng:6543/govolts_staging?sslmode=require&pool_size=10
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=true

# Redis In-Memory Cache
REDIS_URL=rediss://default:CHANGE_ME_IN_SECRET_MANAGER@redis-staging.govolts.ng:6380
REDIS_KEY_PREFIX=govolts:staging:

# Security & JWT Tokens
JWT_SECRET=GENERATE_STAGING_SECRET_KEY_HERE
JWT_ACCESS_EXPIRY_SECONDS=3600
JWT_REFRESH_EXPIRY_SECONDS=604800

# Payment Gateway (Paystack Test Keys)
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=whsec_staging_test_key

# SMS & OTP Provider (Mock / Sandbox Mode)
SMS_PROVIDER=mock
TERMII_API_KEY=termii_test_key
TERMII_SENDER_ID=GoVoltsTest

# Push Notifications (Sandbox Firebase Project)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/secrets/firebase/govolts-staging-firebase-adminsdk.json

# Object Storage
STORAGE_PROVIDER=s3
STORAGE_BUCKET=govolts-staging-media
STORAGE_REGION=eu-west-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_PUBLIC_BASE_URL=https://media-staging.govolts.ng

# Retail Ai & Partner Integration Shared Secrets
RETAIL_AI_WEBHOOK_SIGNING_SECRET=whsec_partner_retail_ai_staging_secret
